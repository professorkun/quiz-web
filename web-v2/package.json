{
  "name": "quiz-web-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:extension": "node scripts/check-extension-point.mjs",
    "verify": "pnpm check:boundaries && pnpm check:extension && pnpm build && pnpm test"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
